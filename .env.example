# کلید واقعی؛ برنامه و تست‌های دستی با این کار می‌کنند. باید کلید پروداکشن باشد. کلید سندباکس موفق برمی‌گرداند ولی پیامک واقعی نمی‌فرستد (طبق مستند sms.ir: Sandbox محیطی تستی است و فقط پیام شبیه‌سازی‌شده می‌دهد و پیامک واقعی ارسال نمی‌کند).
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=
# فقط تست‌های خودکار
SMS_IR_SANDBOX_API_KEY=
SMS_OTP_TEMPLATE_ID=
SMS_INVOICE_TEMPLATE_ID=

NAJVA_API_KEY=
NAJVA_WEBSITE_ID=
NAJVA_SEND_URL=https://push.najva.com/v1/send/token/
# تا سرور و دامنه آماده نشده False بماند
NAJVA_ENABLED=False
# ارسال پیامک بدون قالب فقط از پنل ارسال
SMS_FREE_TEXT_ENABLED=False
# حالت آزمایشی پنل ارسال فقط در محیط لوکال و بدون تماس بیرونی
BROADCAST_DRY_RUN=False

NESHAN_API_KEY=
